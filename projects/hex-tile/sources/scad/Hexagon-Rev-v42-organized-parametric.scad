/*
    Hexagon-Rev-v42-organized-parametric.scad
    -----------------------------------------
    Standalone OpenSCAD model reconstructed from Hexagon-Rev.stl.

    IMPORTANT
    =========
    This file contains the complete geometry internally as a polyhedron.
    No external STL is required.

    The original shape is preserved exactly. The controls below expose all
    transformations that can be changed safely without rebuilding the mesh.

    Because the source is an embedded mesh, geometry-specific features such as
    shell thickness, facet positions, or mounting-tab dimensions are NOT
    independently editable in this version. Those features are baked into the
    source geometry.

    Recommended default:
        units            = "mm";
        size_reference   = "width";
        target_size      = 240.0;
        output_orientation = "vertical";

    Export:
        F6 Render
        File -> Export -> Export as STL
*/


// =============================================================================
// CUSTOMIZER
// =============================================================================


/* [1 - Model Size] */

// Units used for target_size.
units = "mm";                         // [mm, in]

// Which overall source dimension target_size controls.
//
// width  = X dimension when vertical
// height = Z dimension when vertical
// depth  = Y relief/depth dimension
size_reference = "width";             // [width, height, depth]

// Desired overall dimension in the selected units.
//
// Common examples:
//   203.2 mm = 8.0"
//   228.6 mm = 9.0"
//   240.0 mm = 9.449"
//   254.0 mm = 10.0"
target_size = 240.0;

// Additional final uniform multiplier after target-size scaling.
// Normally leave at 1.0.
final_scale_multiplier = 1.0;


/* [2 - Output Orientation] */

// vertical
//   Original uploaded orientation.
//   Best for the fast printing strategy you have been using.
//
// flat_back_down
//   Rotates the back toward the build plate.
//
// flat_face_down
//   Rotates the decorative face toward the build plate.
//   Usually not recommended for this model.
output_orientation = "vertical";      // [vertical, flat_back_down, flat_face_down]

// Optional rotation around the final Z axis.
final_rotation_z_deg = 0;


/* [3 - Build Plate Placement] */

// Automatically move the final model so its lowest point is at Z=0.
auto_place_on_build_plate = true;

// Center the final model around X=0 / Y=0 before user offsets.
center_xy = true;

// Final manual offsets, applied after orientation and auto-placement.
offset_x_mm = 0.0;
offset_y_mm = 0.0;
offset_z_mm = 0.0;


/* [4 - Advanced Scale Controls] */

// Keep this TRUE for normal use.
// This preserves all original proportions.
use_uniform_scaling = true;

// Advanced non-uniform multipliers.
// These are ignored while use_uniform_scaling = true.
//
// WARNING:
// Changing these distorts the original geometry and mounting features.
advanced_scale_x = 1.0;
advanced_scale_y = 1.0;
advanced_scale_z = 1.0;


/* [5 - Mesh / Preview] */

// OpenSCAD convexity hint.
polyhedron_convexity = 20;

// Show diagnostic echoes in the console.
show_diagnostics = true;


/* [6 - Embedded Source Reference] */

// Measured dimensions of the original uploaded Hexagon-Rev.stl.
//
// These should normally NOT be changed.
source_width_mm  = 202.972012;
source_depth_mm  = 14.257996;
source_height_mm = 175.776001;


// =============================================================================
// UNIT CONVERSION
// =============================================================================

target_size_mm =
    units == "in"
        ? target_size * 25.4
        : target_size;


// =============================================================================
// DERIVED SCALE
// =============================================================================

source_reference_mm =
    size_reference == "width"
        ? source_width_mm
        : size_reference == "height"
            ? source_height_mm
            : source_depth_mm;

base_uniform_scale =
    target_size_mm / source_reference_mm;

uniform_scale =
    base_uniform_scale * final_scale_multiplier;

scale_x =
    use_uniform_scaling
        ? uniform_scale
        : uniform_scale * advanced_scale_x;

scale_y =
    use_uniform_scaling
        ? uniform_scale
        : uniform_scale * advanced_scale_y;

scale_z =
    use_uniform_scaling
        ? uniform_scale
        : uniform_scale * advanced_scale_z;


// =============================================================================
// DERIVED DIMENSIONS
// =============================================================================

scaled_width_mm =
    source_width_mm * scale_x;

scaled_depth_mm =
    source_depth_mm * scale_y;

scaled_height_mm =
    source_height_mm * scale_z;


// =============================================================================
// VALIDATION
// =============================================================================

assert(
    target_size > 0,
    "target_size must be greater than zero."
);

assert(
    final_scale_multiplier > 0,
    "final_scale_multiplier must be greater than zero."
);

assert(
    advanced_scale_x > 0
    && advanced_scale_y > 0
    && advanced_scale_z > 0,
    "All advanced scale multipliers must be greater than zero."
);

assert(
    units == "mm" || units == "in",
    "units must be mm or in."
);

assert(
    size_reference == "width"
    || size_reference == "height"
    || size_reference == "depth",
    "size_reference must be width, height, or depth."
);

assert(
    output_orientation == "vertical"
    || output_orientation == "flat_back_down"
    || output_orientation == "flat_face_down",
    "Invalid output_orientation."
);


// =============================================================================
// DIAGNOSTIC OUTPUT
// =============================================================================

if (show_diagnostics) {

    echo("====================================================");
    echo("HEXAGON REV v42 - ORGANIZED PARAMETRIC WRAPPER");
    echo("====================================================");

    echo(str("units                    : ", units));
    echo(str("size reference           : ", size_reference));
    echo(str("target size              : ", target_size, " ", units));
    echo(str("target size mm           : ", target_size_mm, " mm"));

    echo(str("base uniform scale       : ", base_uniform_scale));
    echo(str("final scale multiplier   : ", final_scale_multiplier));

    echo(str("scale X                  : ", scale_x));
    echo(str("scale Y                  : ", scale_y));
    echo(str("scale Z                  : ", scale_z));

    echo(str("scaled width             : ", scaled_width_mm, " mm"));
    echo(str("scaled depth             : ", scaled_depth_mm, " mm"));
    echo(str("scaled height            : ", scaled_height_mm, " mm"));

    echo(str("scaled width inches      : ", scaled_width_mm / 25.4, " in"));
    echo(str("scaled depth inches      : ", scaled_depth_mm / 25.4, " in"));
    echo(str("scaled height inches     : ", scaled_height_mm / 25.4, " in"));

    echo(str("output orientation       : ", output_orientation));
    echo(str("center XY                : ", center_xy));
    echo(str("auto place on plate      : ", auto_place_on_build_plate));

    echo("====================================================");
}


