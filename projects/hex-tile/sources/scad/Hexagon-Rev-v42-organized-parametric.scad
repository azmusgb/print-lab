// =============================================================================
// SOURCE MODEL
// =============================================================================

module source_hexagon_rev() {

    polyhedron(
        points = source_points,
        faces = source_faces,
        convexity = polyhedron_convexity
    );
}


// =============================================================================
// SCALE TRANSFORM
// =============================================================================

module scaled_source() {

    scale(
        [
            scale_x,
            scale_y,
            scale_z
        ]
    )

        source_hexagon_rev();
}


// =============================================================================
// ORIENTATION TRANSFORM
// =============================================================================

module oriented_source() {

    if (output_orientation == "vertical") {

        scaled_source();

    } else if (output_orientation == "flat_back_down") {

        // Original depth axis is Y.
        // Rotate so the back/depth direction becomes vertical.
        rotate([90, 0, 0])
            scaled_source();

    } else if (output_orientation == "flat_face_down") {

        rotate([-90, 0, 0])
            scaled_source();
    }
}


// =============================================================================
// BOUNDS HELPERS
// =============================================================================
//
// The embedded model was normalized in v41 so:
//   X is centered about zero
//   Y is centered about zero
//   source minimum Z = 0
//
// For vertical output, bounds are known analytically.
// For flat orientations, we use source dimensions after scaling.

vertical_half_x =
    scaled_width_mm / 2;

vertical_half_y =
    scaled_depth_mm / 2;

vertical_min_z =
    0;

flat_half_x =
    scaled_width_mm / 2;

flat_half_y =
    scaled_height_mm / 2;

flat_model_height =
    scaled_depth_mm;


// =============================================================================
// FINAL PLACEMENT
// =============================================================================

module placed_source() {

    // XY centering is already inherent in the embedded source for vertical mode.
    // Flat modes also remain centered after rotation.
    //
    // Auto-placement only needs to compensate for final orientation.

    auto_z =
        !auto_place_on_build_plate
            ? 0
            : output_orientation == "vertical"
                ? 0
                : scaled_depth_mm / 2;

    translate(
        [
            offset_x_mm,
            offset_y_mm,
            offset_z_mm + auto_z
        ]
    )

    rotate([0, 0, final_rotation_z_deg])

        oriented_source();
}


// =============================================================================
// OUTPUT
// =============================================================================

placed_source();
